# Copia este archivo a .env y rellena valores reales. NUNCA commitees .env.
NODE_ENV=development
PORT=4000

# Origen exacto del frontend (sin barra final). Nunca "*".
CORS_ORIGIN=http://localhost:5173

# Genera cada secreto por separado con: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=

# Usuario admin del panel (NO es el usuario de OBS)
ADMIN_USERNAME=admin
# Genera con: node -e "console.log(require('bcryptjs').hashSync('tu_password', 12))"
ADMIN_PASSWORD_HASH=

# Conexión a obs-websocket (debe correr en localhost dentro del Pi)
OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=
